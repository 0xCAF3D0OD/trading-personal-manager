# ============================================================
#  trading-personal-manager — variables d'environnement
#  Copier en .env à la racine. Le fichier .env est gitignoré.
#  AUCUNE de ces valeurs ne doit être préfixée VITE_ : tout ce
#  qui est VITE_* est embarqué dans le bundle navigateur.
# ============================================================

# --- Backend -------------------------------------------------
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/app.db
LOG_LEVEL=info
# Origine autorisée pour le CORS en dev (le front Vite tourne sur 5173)
CORS_ORIGIN=http://localhost:5173

# --- RPC Solana ----------------------------------------------
# Palier A : RPC public. Suffisant pour santé, offre, burn, top 20.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Palier B (recommandé) : Helius gratuit. Débloque le nombre total de
# détenteurs, le top 50 / top 100 et les activités du créateur.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=VOTRE_CLE_HELIUS
# Clé Helius pour l'API Enhanced Transactions. Si vide, extraite de
# SOLANA_RPC_URL (paramètre api-key).
HELIUS_API_KEY=
# Nombre max de pages (1000 comptes/page) lues par snapshot détenteurs.
HELIUS_MAX_HOLDER_PAGES=200

# --- Solscan Pro (optionnel, palier C) -----------------------
# Repli uniquement : créateur / date de création si les métadonnées
# on-chain sont muettes, recoupement ponctuel. Jamais appelé en boucle.
SOLSCAN_API_KEY=
SOLSCAN_MONTHLY_CU_BUDGET=1000000

# --- Sources gratuites (URLs surchargées uniquement pour test) ---
DEXSCREENER_BASE_URL=https://api.dexscreener.com
JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v3
RUGCHECK_BASE_URL=https://api.rugcheck.xyz/v1

# --- Jobs planifiés (syntaxe cron, fuseau du conteneur) -------
CRON_MARKET_SNAPSHOT=*/15 * * * *
CRON_HOLDER_SNAPSHOT=0 6 * * *
CRON_ALERT_EVAL=* * * * *
# Passer à false pour désactiver tous les jobs (tests, debug)
JOBS_ENABLED=true

# --- Notifications (au moins un canal pour recevoir les alertes) ---
# ntfy : créer un topic difficile à deviner, s'y abonner depuis l'app mobile.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Optionnel : token d'accès si le serveur ntfy est protégé
NTFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Veille sur les annonces (module 0.3.0) --------------------
# Service de rendu sans tête (conteneur `renderer` du docker-compose). Vide = découverte
# des API JSON et mode « rendu sans tête » indisponibles ; les modes HTML et API JSON restent.
RENDERER_URL=http://renderer:3100
# Contact inséré dans le User-Agent des snapshots de sites (courtoisie envers les administrateurs).
WATCH_USER_AGENT_CONTACT=
# Optionnel : palier développeur gratuit CryptoPanic (couvre rarement les tokens de quelques semaines).
CRYPTOPANIC_API_KEY=
# Optionnel : passe l'API GitHub de 60 à 5 000 requêtes par heure.
GITHUB_TOKEN=
# Optionnel : API X v2 (payante). Sans elle, import d'un post par l'endpoint oEmbed officiel + saisie assistée.
X_BEARER_TOKEN=

# --- Rate limit des routes internes --------------------------
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
# Sur les routes qui peuvent déclencher un appel externe coûteux
RATE_LIMIT_EXPENSIVE_MAX=10

# --- Frontend (public par construction) ----------------------
VITE_API_BASE=/api
